---
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Product',
    links: [
      { label: 'Services', href: '/services' },
      { label: 'Pricing', href: '/pricing' },
      { label: 'Open App', href: 'https://app.fusionpulse.colefusion.com' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Contact', href: '/contact' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { label: 'GitHub', href: 'https://github.com/ColeFusion-Consulting/fusionpulse' },
      { label: 'CLI (npm)', href: 'https://www.npmjs.com/package/@fusionpulse/cli' },
    ],
  },
];
---

<footer class="border-t border-zinc-800 bg-zinc-950">
  <div class="mx-auto max-w-6xl px-6 py-14">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-5">
      <div class="col-span-2">
        <Logo size={28} />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-zinc-500">
          AI-powered testing and monitoring. Describe what to test in plain English — we handle the rest.
        </p>
        <p class="mt-5 text-xs font-medium uppercase tracking-wider text-zinc-600">
          AI Testing Powered by ColeFusion
        </p>
      </div>

      {columns.map((col) => (
        <div>
          <h4 class="text-sm font-semibold text-zinc-200">{col.title}</h4>
          <ul class="mt-4 space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-zinc-500 transition-colors hover:text-zinc-200">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-zinc-800 pt-8 sm:flex-row">
      <p class="text-xs text-zinc-600">© {year} ColeFusion. All rights reserved.</p>
      <p class="text-xs text-zinc-600">
        <a href="mailto:hello@colefusion.com" class="hover:text-zinc-400">hello@colefusion.com</a>
      </p>
    </div>
  </div>
</footer>
