---
import type { IconName } from '../lib/icon-names';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', strokeWidth = 1.75 } = Astro.props;

const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': strokeWidth,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

{name === 'sparkles' && (
  <svg {...common} class={className}>
    <path d="M11 2 L12.6 8.2 L19 10 L12.6 11.8 L11 18 L9.4 11.8 L3 10 L9.4 8.2 Z" />
    <path d="M18.5 14 L19.2 16.6 L21.8 17.3 L19.2 18 L18.5 20.6 L17.8 18 L15.2 17.3 L17.8 16.6 Z" />
  </svg>
)}

