---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

const APP_URL = 'https://app.fusionpulse.colefusion.net';
---

<BaseLayout title="Services" description="FusionPulse Test, Monitor, API, and CLI — AI-powered testing and monitoring for every stage of your stack.">
  <section class="bg-radial-glow py-20 sm:py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-fusion-magenta">Services</p>
      <h1 class="mt-4 text-4xl font-semibold leading-tight text-white sm:text-5xl">
        One platform. <span class="text-gradient-fusion">Four ways to use it.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-zinc-400">
        Start with the free CLI, move to the cloud dashboard when you need scheduling and alerts, and reach for
        the API when you want it wired into your own tools.
      </p>
    </div>
  </section>

  <!-- FusionPulse Test -->
  <section class="border-t border-zinc-800/80 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2">
      <div>
        <div class="inline-flex rounded-lg bg-zinc-900 p-2.5 text-fusion-magenta">
          <Icon name="sparkles" size={22} />
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-white sm:text-3xl">FusionPulse Test</h2>
        <p class="mt-3 text-zinc-400">
          Describe a user flow in plain English. FusionPulse generates a real Playwright test — selectors,
          waits, and assertions included — and keeps it working as your UI evolves.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-zinc-300">
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Natural-language test authoring, no selectors to hand-write</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> AI auto-heal detects and repairs broken selectors</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Runs on your schedule, or triggered from CI</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Choose cloud AI (OpenAI/Anthropic) or your own self-hosted model</li>
        </ul>
      </div>
      <div class="card-glass rounded-2xl p-1">
        <div class="rounded-xl bg-zinc-950/60 p-6 font-mono text-xs leading-relaxed text-zinc-400">
          <p class="text-zinc-500">test: "checkout-flow"</p>
          <p class="mt-3"><span class="text-fusion-violet">1.</span> goto <span class="text-zinc-200">"/cart"</span></p>
          <p><span class="text-fusion-violet">2.</span> click <span class="text-zinc-200">"Apply promo code"</span></p>
          <p><span class="text-fusion-violet">3.</span> fill <span class="text-zinc-200">"SAVE10"</span></p>
          <p><span class="text-fusion-violet">4.</span> click <span class="text-zinc-200">"Checkout"</span></p>
          <p><span class="text-fusion-violet">5.</span> expect <span class="text-zinc-200">confirmation email sent</span></p>
          <p class="mt-3 text-pulse">✓ 5/5 steps passed · 2.4s</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FusionPulse Monitor -->
  <section class="border-t border-zinc-800/80 bg-zinc-900/20 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2">
      <div class="order-2 card-glass rounded-2xl p-6 lg:order-1">
        <div class="flex items-center justify-between text-xs text-zinc-500">
          <span>api.yourapp.com</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-2.5 py-1 font-medium text-pulse">
            <span class="h-1.5 w-1.5 rounded-full bg-pulse"></span> Operational
          </span>
        </div>
        <div class="mt-4 flex items-end gap-1">
          {Array.from({ length: 28 }).map((_, i) => (
            <div class:list={["w-full rounded-sm bg-pulse/70", i === 11 ? "h-3 bg-orange-400" : "h-8"]}></div>
          ))}
        </div>
        <p class="mt-4 text-xs text-zinc-500">99.98% uptime · last 28 days · checked every 5s</p>
      </div>
      <div class="order-1 lg:order-2">
        <div class="inline-flex rounded-lg bg-zinc-900 p-2.5 text-fusion-magenta">
          <Icon name="activity" size={22} />
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-white sm:text-3xl">FusionPulse Monitor</h2>
        <p class="mt-3 text-zinc-400">
          HTTP and uptime checks as frequent as every 5 seconds, from a plan that fits how much you care about
          being the first to know.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-zinc-300">
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Intervals from 5 seconds (Pro/Business) to 1 minute (Free)</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Multi-location checks on Starter and above</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Public, brandable status pages included</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> SLA-backed uptime guarantees on Business</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FusionPulse API -->
  <section class="border-t border-zinc-800/80 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2">
      <div>
        <div class="inline-flex rounded-lg bg-zinc-900 p-2.5 text-fusion-magenta">
          <Icon name="code" size={22} />
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-white sm:text-3xl">FusionPulse API</h2>
        <p class="mt-3 text-zinc-400">
          Everything in the dashboard is available programmatically — monitors, test suites, alert history, and
          usage — so you can wire FusionPulse into your own tools and dashboards.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-zinc-300">
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> REST API for monitors, tests, and notifications</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Webhooks for every alert and test result</li>
          <li class="flex items-start gap-2.5"><Icon name="check" size={16} class="mt-0.5 shrink-0 text-pulse" /> Official GitHub Action for CI-triggered runs</li>
        </ul>
      </div>
      <div class="card-glass rounded-2xl p-1">
        <div class="rounded-xl bg-zinc-950/60 p-6 font-mono text-xs leading-relaxed text-zinc-400">
          <p><span class="text-fusion-violet">curl</span> https://app.fusionpulse.colefusion.net/api/tests \</p>
          <p class="pl-8">-H <span class="text-zinc-200">"Authorization: Bearer $FP_API_KEY"</span> \</p>
          <p class="pl-8">-d <span class="text-zinc-200">'&#123;"prompt": "Test the login flow"&#125;'</span></p>
          <p class="mt-3 text-pulse">&#123; "status": "queued", "testId": "t_8fk2..." &#125;</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FusionPulse CLI -->
  <section class="border-t border-zinc-800/80 bg-zinc-900/20 py-20">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-6 lg:grid-cols-2">
      <div class="order-2 card-glass rounded-2xl p-1 lg:order-1">
        <div class="rounded-xl bg-zinc-950/60 p-6 font-mono text-xs leading-relaxed text-zinc-400">
          <p class="text-zinc-500">$ npm install -g @fusionpulse/cli</p>
          <p class="mt-2 text-zinc-500">$ fusionpulse generate -p "Test the login flow"</p>
          <p class="mt-3 text-pulse">✓ Wrote tests/login-flow.spec.ts</p>
        </div>
      </div>
      <div class="order-1 lg:order-2">
        <div class="inline-flex rounded-lg bg-zinc-900 p-2.5 text-fusion-magenta">
          <Icon name="terminal" size={22} />
        </div>
        <h2 class="mt-5 text-2xl font-semibold text-white sm:text-3xl">FusionPulse CLI</h2>
        <p class="mt-3 text-zinc-400">
          Free and open-source, forever. Generate Playwright tests locally with your own OpenAI key — no account
          required. Upgrade to the cloud platform when you want scheduling, monitoring, and alerts.
        </p>
        <a
          href="https://github.com/ColeFusion-Consulting/fusionpulse"
          class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-fusion-magenta hover:text-fusion-orange"
        >
          View on GitHub
          <Icon name="arrow-right" size={15} strokeWidth={2.25} />
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-800/80 py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">Pick a plan and start testing today</h2>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href={APP_URL} class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-fusion px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg shadow-fuchsia-500/20 transition-transform hover:scale-[1.03] sm:w-auto">
          Get Started Free
        </a>
        <a href="/pricing" class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:bg-zinc-900 sm:w-auto">
          Compare Plans
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
