---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icon-names';

const APP_URL = 'https://app.fusionpulse.colefusion.net';

const features: { icon: IconName; title: string; body: string }[] = [
  {
    icon: 'sparkles',
    title: 'AI Test Generation',
    body: 'Describe a scenario in plain English. FusionPulse writes the Playwright steps, selectors, and assertions for you.',
  },
  {
    icon: 'activity',
    title: 'Smart Monitoring',
    body: 'HTTP and uptime checks on intervals as fast as 5 seconds, from your choice of plan.',
  },
  {
    icon: 'zap',
    title: 'Auto-Heal Selectors',
    body: 'When your UI changes and a selector breaks, AI detects it and suggests — or applies — a fix automatically.',
  },
  {
    icon: 'bell',
    title: 'Multi-Channel Alerts',
    body: 'PagerDuty, Slack, Discord, email, SMS, phone calls, or custom webhooks — get paged the way you want.',
  },
  {
    icon: 'globe',
    title: 'Public Status Pages',
    body: 'Shareable, branded status pages for your own customers, generated automatically from your monitors.',
  },
  {
    icon: 'terminal',
    title: 'Free OSS CLI',
    body: '@fusionpulse/cli generates tests locally for free, forever — upgrade only when you want cloud scheduling and alerts.',
  },
];

const steps = [
  { n: '01', title: 'Describe the test', body: 'Write what should happen in plain English — no selectors, no boilerplate.' },
  { n: '02', title: 'AI writes the code', body: 'FusionPulse turns your description into a real, runnable Playwright test.' },
  { n: '03', title: 'We watch it for you', body: 'Tests and uptime checks run on your schedule. You get alerted the moment something breaks.' },
];
---

<BaseLayout title="FusionPulse" description="AI-powered E2E testing and uptime monitoring. Describe what to test in plain English — FusionPulse writes the Playwright tests, watches your endpoints, and alerts your team when something breaks.">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-radial-glow">
    <div class="mx-auto max-w-6xl px-6 pb-20 pt-20 sm:pt-28">
      <div class="mx-auto max-w-3xl text-center">
        <div class="ring-fusion mx-auto inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium text-zinc-300">
          <Icon name="sparkles" size={14} class="text-fusion-magenta" />
          AI Testing Powered by ColeFusion
        </div>

        <h1 class="mt-6 text-4xl font-semibold leading-[1.1] text-white sm:text-6xl">
          Testing and monitoring, <span class="text-gradient-fusion">written in plain English.</span>
        </h1>

        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-zinc-400">
          FusionPulse turns a sentence into a Playwright test, watches your endpoints around the clock, and heals broken selectors before your team even notices.
        </p>

        <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <a
            href={APP_URL}
            class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-fusion px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg shadow-fuchsia-500/20 transition-transform hover:scale-[1.03] sm:w-auto"
          >
            Open App
            <Icon name="arrow-right" size={16} strokeWidth={2.25} />
          </a>
          <a
            href="/pricing"
            class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:bg-zinc-900 sm:w-auto"
          >
            View Pricing
          </a>
        </div>
      </div>

      <!-- Console mockup -->
      <div class="card-glass mx-auto mt-16 max-w-2xl rounded-2xl p-1 shadow-2xl shadow-black/40">
        <div class="rounded-xl bg-zinc-950/60 p-6 font-mono text-sm">
          <div class="flex items-center gap-1.5 pb-4">
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-zinc-700"></span>
          </div>
          <p class="text-zinc-500">$ fusionpulse generate</p>
          <p class="mt-3 text-zinc-300">
            <span class="text-fusion-magenta">&gt;</span> "Test the checkout flow: add item to cart, apply promo code
            <span class="text-zinc-500">SAVE10</span>, complete payment, verify confirmation email arrives"
          </p>
          <div class="mt-4 space-y-1.5 text-zinc-400">
            <p><span class="text-pulse">✓</span> Generated 8 Playwright steps</p>
            <p><span class="text-pulse">✓</span> Running against staging…</p>
            <p><span class="text-pulse">✓</span> All assertions passed <span class="text-zinc-600">(2.4s)</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="border-t border-zinc-800/80 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">Everything your test suite is missing</h2>
        <p class="mt-4 text-zinc-400">One platform for generating tests, running them, watching your endpoints, and telling your team the moment something goes wrong.</p>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((f) => (
          <div class="card-glass rounded-2xl p-6 transition-colors hover:border-zinc-700">
            <div class="inline-flex rounded-lg bg-zinc-900 p-2.5 text-fusion-magenta">
              <Icon name={f.icon} size={20} />
            </div>
            <h3 class="mt-4 text-base font-semibold text-white">{f.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-t border-zinc-800/80 bg-zinc-900/20 py-20">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-semibold text-white sm:text-4xl">From sentence to test in seconds</h2>
      </div>

      <div class="mt-14 grid grid-cols-1 gap-8 sm:grid-cols-3">
        {steps.map((s) => (
          <div>
            <span class="font-display text-3xl font-semibold text-gradient-fusion">{s.n}</span>
            <h3 class="mt-3 text-lg font-semibold text-white">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-400">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-zinc-800/80 py-24">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-3xl font-semibold text-white sm:text-4xl">Stop babysitting your test suite.</h2>
      <p class="mt-4 text-zinc-400">Free forever for small projects. Upgrade when you need faster monitoring and AI auto-heal.</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href={APP_URL}
          class="inline-flex w-full items-center justify-center gap-2 rounded-full bg-gradient-fusion px-6 py-3 text-sm font-semibold text-zinc-950 shadow-lg shadow-fuchsia-500/20 transition-transform hover:scale-[1.03] sm:w-auto"
        >
          Get Started Free
          <Icon name="arrow-right" size={16} strokeWidth={2.25} />
        </a>
        <a
          href="/contact"
          class="inline-flex w-full items-center justify-center gap-2 rounded-full border border-zinc-700 px-6 py-3 text-sm font-semibold text-zinc-200 transition-colors hover:border-zinc-500 hover:bg-zinc-900 sm:w-auto"
        >
          Talk to Us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
