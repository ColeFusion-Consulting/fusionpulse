---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="flex min-h-[60vh] items-center justify-center px-6 py-24 text-center">
    <div>
      <p class="font-display text-6xl font-semibold text-gradient-fusion">404</p>
      <h1 class="mt-4 text-2xl font-semibold text-white">This page took a wrong turn.</h1>
      <p class="mt-3 text-zinc-400">The page you're looking for doesn't exist — maybe it moved, maybe it never did.</p>
      <a
        href="/"
        class="mt-8 inline-flex items-center justify-center gap-2 rounded-full bg-gradient-fusion px-6 py-3 text-sm font-semibold text-zinc-950"
      >
        Back to home
      </a>
    </div>
  </section>
</BaseLayout>
