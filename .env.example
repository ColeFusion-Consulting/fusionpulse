# ─── FusionPulse Environment Variables ─────────────────────────
# Copy to .env and fill in values. Required vars are marked.

# ─── Server ───────────────────────────────────────────────────
# Port for the API server (defaults to 3001).
PORT=3001
API_PORT=3001

# Environment: development | staging | production
NODE_ENV=development

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.fusionpulse.colefusion.com

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusionpulse

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (JWT) ───────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ISSUER=fusionpulse
JWT_AUDIENCE=fusionpulse

# ─── Auth (Cognito) ───────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ─── AI ───────────────────────────────────────────────────────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
LLAMA_URL=

# ─── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# ─── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Contact Form (SES) ──────────────────────────────────────
CONTACT_FROM_EMAIL=contact@colefusion.com
CONTACT_TO_EMAIL=cole@colefusion.com

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Signup Mode ─────────────────────────────────────────────
# Set to "live" to enable self-service signup flow, or "preregister" for early access.
SIGNUP_MODE=preregister
PUBLIC_SIGNUP_MODE=preregister

# ─── Cross-Service URLs ──────────────────────────────────────
SITE_MONITOR_URL=http://192.168.50.206:3456
AI_REPAIR_AGENT_URL=http://192.168.50.206:3457

# ─── Internal API Key ─────────────────────────────────────────
INTERNAL_API_KEY=dev-internal-key-change-in-production

# ─── Proxmox (dev/staging only) ──────────────────────────────
PROXMOX_DEV_HOST=
PROXMOX_STAGING_HOST=
PROXMOX_DEPLOY_USER=
PROXMOX_SSH_KEY=
