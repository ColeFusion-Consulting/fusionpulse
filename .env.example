# Production environment variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusionpulse

# Auth
JWT_SECRET=change-me-in-production
JWT_ISSUER=
JWT_AUDIENCE=

# AI
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
LLAMA_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# AWS (used for SES email in all envs; ECS task role covers the rest in prod)
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Contact form (SES must have CONTACT_FROM_EMAIL's domain verified)
CONTACT_FROM_EMAIL=contact@colefusion.net
CONTACT_TO_EMAIL=colemcmannus@gmail.com

# Proxmox (dev/staging only)
PROXMOX_DEV_HOST=
PROXMOX_STAGING_HOST=
PROXMOX_DEPLOY_USER=
PROXMOX_SSH_KEY=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
